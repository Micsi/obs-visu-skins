{
  "name": "terminal",
  "targetsContract": "1.11",
  "renderers": "./renderers.ts",
  "unsupported": [],

  "gestures": { "tap": "action", "longPress": "openDetail" },

  "widgets": {
    "light": { "actions": ["toggle"] },
    "switch": { "actions": ["toggle"] },
    "blind": { "actions": ["setPosition", "applyPreset", "lock", "unlock"] },
    "jalousie": { "actions": ["setPosition", "applyPreset", "lock", "unlock"] },
    "sensor": { "actions": [] },
    "scene": { "actions": ["activateScene"] },
    "media": { "actions": ["playPause", "stop", "next", "previous"] },
    "camera": { "actions": ["refresh"] },
    "climate": { "actions": ["setSetpoint"] }
  },

  "layout": {
    "model": "list",
    "list": {
      "row": { "minPx": 44 },
      "gutter": 0,
      "flow": "column"
    },
    "honors": ["order", "grouping"]
  },

  "themes": ["light", "dark"]
}
